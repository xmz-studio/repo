#!/bin/bash
# Batch-modify the Maintainer or Author field in .deb packages.
# If the field value exactly matches one of OLD_VALUES, replace it with NEW.
#
# Old values (exact whole-string match):
#   XMZ
#   XMZ-Team
#   XMZ-Team <xmz-team@outlook.com>
#   XMZ <xmz-team@outlook.com>

NEW='XMZ Studio <xmz-studio@github.com>'
OLD_VALUES=(
    'XMZ'
    'XMZ-Team'
    'XMZ-Team <xmz-team@outlook.com>'
    'XMZ <xmz-team@outlook.com>'
    'XMZ Studio <xmz-team@github.com>'
)
TARGET_DIR="${1:-.}"

if [ ! -d "$TARGET_DIR" ]; then
    echo "[Error] Not a directory: $TARGET_DIR"
    exit 1
fi

# Check whether a value is in the candidate set
is_old() {
    local v="$1" o
    for o in "${OLD_VALUES[@]}";
    do
        [ "$v" = "$o" ] && return 0
    done
    return 1
}

while IFS= read -r -d '' deb;
do
    name=$(basename "$deb")
    tmp=$(mktemp -d)

    if ! dpkg-deb -R "$deb" "$tmp/pkg" 2>/dev/null; then
        echo "[Skip] Unpacking failed: $name"
        rm -rf "$tmp"; continue
    fi

    ctrl="$tmp/pkg/DEBIAN/control"
    changed=0

    for field in Maintainer Author;
    do
        # Use dpkg-deb -f for reliability (handles continuation lines)
        cur=$(dpkg-deb -f "$deb" "$field" 2>/dev/null)
        if is_old "$cur"; then
            # Replace the whole line for this field
            awk -v f="$field" -v n="$NEW" '
                BEGIN{FS=OFS=":"}
                $1==f {print f": "n; next}
                {print}
            ' "$ctrl" > "$ctrl.tmp" && mv "$ctrl.tmp" "$ctrl"
            echo "  - $field: [$cur] -> [$NEW]"
            changed=1
        fi
    done

    if [ "$changed" -eq 0 ]; then
        echo "[Skip] No change needed: $name"
        rm -rf "$tmp"; continue
    fi

    out="${deb}.new.$$"
    if dpkg-deb --build "$tmp/pkg" "$out" >/dev/null 2>&1 && mv -f "$out" "$deb"; then
        echo "[OK] $name modified (overwritten)"
    else
        rm -f "$out"
        echo "[Fail] Repackaging failed: $name"
    fi

    rm -rf "$tmp"
done < <(find "$TARGET_DIR" -type f -name '*.deb' -print0)
