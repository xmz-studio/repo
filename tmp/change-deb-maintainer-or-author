#!/bin/bash

OLD='XMZ <xmz-team@outlook.com>'
NEW='XMZ Studio <xmz-team@github.com>'
TARGET_DIR="$1"

if [ -z "${TARGET_DIR}" ]; then
    echo "[Error]: need target dir"
    exit 1
fi

if [ ! -d "$TARGET_DIR" ]; then
    echo "[Error]: not a directory: $TARGET_DIR"
    exit 1
fi

while IFS= read -r -d '' deb; do
    name=$(basename "$deb")
    tmp=$(mktemp -d)

    if ! dpkg-deb -R "$deb" "$tmp/pkg" 2>/dev/null; then
        echo "[Skip] unpacking failed: $name"
        rm -rf "$tmp"; continue
    fi

    ctrl="$tmp/pkg/DEBIAN/control"
    changed=0

    for field in Maintainer Author; do
        cur=$(sed -n "s/^${field}:[[:space:]]*//p" "$ctrl" | head -n1)
        if [ "$cur" = "$OLD" ]; then
            awk -v f="$field" -v n="$NEW" '
                BEGIN{FS=OFS=":"}
                $1==f {print f": "n; next}
                {print}
            ' "$ctrl" > "$ctrl.tmp" && mv "$ctrl.tmp" "$ctrl"
            changed=1
        fi
    done

    if [ "$changed" -eq 0 ]; then
        echo "[Skip] no need to modify: $name"
        rm -rf "$tmp"; continue
    fi

    out="${deb}.new.$$"
    if dpkg-deb --build "$tmp/pkg" "$out" >/dev/null 2>&1 && mv -f "$out" "$deb"; then
        echo "[OK] $name modified (overwritten)"
    else
        rm -f "$out"
        echo "[Fail] repackage failed: $name"
    fi

    rm -rf "$tmp"
done < <(find "$TARGET_DIR" -type f -name '*.deb' -print0)
