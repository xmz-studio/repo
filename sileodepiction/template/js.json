{
    "class": "DepictionTabView",
    "headerImage": "https://xmz-studio.github.io/repo/sileodepiction/Default/top_0.png",
    "tintColor": "#1DBBFF",
    "minVersion": "0.3",
    "tabs": [
        {
            "class": "DepictionStackView",
            "tabname": "Description",
            "views": [
                {
                    "class": "DepictionMarkdownView",
                    "markdown": "<Description>",
                    "useRawFormat": false
                },
