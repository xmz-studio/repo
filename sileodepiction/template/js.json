{
    "class": "DepictionTabView",
    "headerImage": "https://xmz-studio.github.io/repo/sileodepiction/Default/top_0.png",
    "tintColor": "#1DBBFF",
    "minVersion": "0.3",
    "tabs": [
        {
            "class": "DepictionStackView",
            "tabname": "Description",
            "views": [
                {
                    "class": "DepictionMarkdownView",
                    "markdown": "<Description>",
                    "useRawFormat": false
                },
/*
 * optional screenshot description
                {
                    "class": "DepictionScreenshotsView",
                    "itemCornerRadius": 6,
                    "itemSize": "{160, 346.4533333333333}",
                    "screenshots": [
                        {
                            "accessibilityText": "Screenshot",
                            "url": "https://xmz-studio.github.io/repo/sileodepiction/<package name>/<image name>.png"
                            /* or use image of default */
                            /* "url": "https://xmz-studio.github.io/repo/sileodepiction/Default/<image name>.png" */
                        }
                    ]
                },
 */
                {
                    "class": "DepictionSpacerView",
                    "spacing": 16
                },
                {
                    "class": "DepictionSeparatorView"
                },
                {
                    "class": "DepictionSpacerView",
                    "spacing": 16
                },
                {
                    "class": "DepictionHeaderView",
                    "title": "Details",
                    "useBoldText": true,
                    "useBottomMargin": false
                },
                {
                    "class": "DepictionSpacerView",
                    "spacing": 8
                },
                {
                    "class": "DepictionMarkdownView",
                    "text": "**Author:** <author name> `<author email>`"
                },
                {
                    "class": "DepictionMarkdownView",
                    "text": "**Maintainer:** <Maintainer name> `<maintainer email>`"
                },
                {
                    "class": "DepictionMarkdownView",
                    "text": "**Latest version:** `<version>`"
                },
                {
                    "class": "DepictionMarkdownView",
                    "markdown": "Supported OS Range:** `<OS version>`"
                    /* or */
                    /* "markdown": "Supported OS Range:** `<OS version-OS version>`" */
                },
                {
                    "class": "DepictionMarkdownView",
                    "text": "**Last update:** `Year-Moon-Day`"
                },
                {
                    "class": "DepictionSpacerView",
                    "spacing": 16
                }
            ]
        },
        {
            "class": "DepictionStackView",
            "tabname": "Update log",
            "views": [
                {
                    "class": "DepictionSubheaderView",
                    "title": "<version>",
                    "useBoldText": true,
                    "useBottomMargin": false
                },
                {
                    "class": "DepictionMarkdownView",
                    "markdown": "<Description>",
                    "useRawFormat": true
                }
            ]
        }
    ]
}